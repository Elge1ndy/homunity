{
  "name": "homeunity-exe",
  "version": "1.0.0",
  "main": "electron/main.js",
  "private": true,
  "description": "Homeunity - حزمة نسخة EXE للتطبيق",
  "scripts": {
    "build:exe": "pkg exe/main.js --targets node20-win-x64 --output dist/Homeunity.exe --config pkg.json --icon exe/icon.ico",
    "build:desktop": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.0",
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3"
  }
}
